<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>short-url | Smart URL Shortener</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #080b16;
            --panel: #111629;
            --panel-light: #171d34;
            --primary: #8b5cf6;
            --primary-hover: #7c3aed;
            --blue: #60a5fa;
            --text: #f8fafc;
            --muted: #929bb5;
            --border: rgba(148, 163, 184, 0.14);
            --success: #34d399;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            font-family: "Inter", sans-serif;
            color: var(--text);
            background:
                radial-gradient(ellipse at 15% 0%, rgba(124, 58, 237, 0.17), transparent 38%),
                radial-gradient(ellipse at 95% 25%, rgba(37, 99, 235, 0.12), transparent 35%),
                var(--bg);
            padding: 0 24px 60px;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .navbar {
            max-width: 1160px;
            margin: auto;
            height: 86px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 23px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 13px;
            color: white;
            font-size: 22px;
            background: linear-gradient(135deg, #a78bfa, #6d28d9);
            box-shadow: 0 5px 25px rgba(139, 92, 246, 0.3);
        }

        .brand span {
            color: #a78bfa;
        }

        .nav-tag {
            padding: 9px 14px;
            border: 1px solid var(--border);
            border-radius: 30px;
            color: #c4b5fd;
            background: rgba(139, 92, 246, 0.08);
            font-size: 12px;
            font-weight: 600;
        }

        .hero {
            max-width: 850px;
            margin: 78px auto 52px;
            text-align: center;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 13px;
            border: 1px solid rgba(167, 139, 250, 0.23);
            border-radius: 30px;
            background: rgba(139, 92, 246, 0.08);
            color: #c4b5fd;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .eyebrow-dot {
            width: 7px;
            height: 7px;
            background: var(--success);
            border-radius: 50%;
            box-shadow: 0 0 12px rgba(52, 211, 153, 0.7);
        }

        h1 {
            margin: 24px 0 18px;
            font-size: clamp(38px, 6vw, 64px);
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -3px;
        }

        h1 .gradient-text {
            background: linear-gradient(100deg, #c4b5fd 10%, #8b5cf6 52%, #60a5fa 95%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-description {
            max-width: 590px;
            margin: auto;
            color: var(--muted);
            font-size: 15px;
            line-height: 1.8;
        }

        .shortener-card {
            max-width: 780px;
            margin: 0 auto 28px;
            padding: 32px;
            border: 1px solid rgba(167, 139, 250, 0.2);
            border-radius: 22px;
            background: linear-gradient(145deg, rgba(23, 29, 52, 0.96), rgba(14, 19, 36, 0.96));
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.28);
        }

        .card-heading {
            margin-bottom: 22px;
        }

        .card-heading h2 {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .card-heading p {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.6;
        }

        label {
            display: block;
            margin-bottom: 11px;
            color: #dbe2f3;
            font-size: 13px;
            font-weight: 600;
        }

        .input-group {
            display: flex;
            gap: 12px;
        }

        input[name="url"] {
            flex: 1;
            min-width: 0;
            height: 56px;
            padding: 0 18px;
            color: white;
            background: #0b1020;
            border: 1px solid #303852;
            border-radius: 12px;
            outline: none;
            font-family: inherit;
            font-size: 14px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        input[name="url"]::placeholder {
            color: #67718c;
        }

        input[name="url"]:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
        }

        .submit-btn {
            min-width: 155px;
            height: 56px;
            padding: 0 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            border: 0;
            border-radius: 12px;
            color: white;
            background: linear-gradient(135deg, #8b5cf6, #6d28d9);
            font-family: inherit;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 8px 24px rgba(124, 58, 237, 0.25);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(124, 58, 237, 0.38);
        }

        .submit-btn:active {
            transform: translateY(0);
        }

        .helper-text {
            margin-top: 14px;
            display: flex;
            align-items: center;
            gap: 7px;
            color: #818ba5;
            font-size: 12px;
        }

        /* Generated URL */
        .result-card {
            max-width: 780px;
            margin: 0 auto 48px;
            padding: 22px 25px;
            border: 1px solid rgba(52, 211, 153, 0.23);
            border-radius: 16px;
            background: rgba(16, 185, 129, 0.07);
        }

        .result-title {
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 9px;
            color: #6ee7b7;
            font-size: 14px;
            font-weight: 700;
        }

        .result-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
        }

        .result-link a {
            min-width: 0;
            overflow-wrap: anywhere;
            color: #d1fae5;
            font-size: 14px;
            line-height: 1.7;
        }

        .copy-btn {
            flex-shrink: 0;
            padding: 10px 14px;
            border: 1px solid rgba(52, 211, 153, 0.3);
            border-radius: 9px;
            color: #6ee7b7;
            background: rgba(52, 211, 153, 0.08);
            font-family: inherit;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
        }

        .copy-btn:hover {
            background: rgba(52, 211, 153, 0.16);
        }

        /* Links dashboard */
        .dashboard {
            max-width: 1160px;
            margin: 0 auto;
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 23px;
        }

        .section-heading h2 {
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -0.6px;
        }

        .section-heading p {
            margin-top: 7px;
            color: var(--muted);
            font-size: 13px;
        }

        .link-count {
            padding: 8px 12px;
            border: 1px solid var(--border);
            border-radius: 9px;
            background: var(--panel);
            color: #c4b5fd;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .table-card {
            overflow: hidden;
            border: 1px solid var(--border);
            border-radius: 17px;
            background: rgba(17, 22, 41, 0.88);
            box-shadow: 0 18px 50px rgba(0, 0, 0, 0.14);
        }

        .table-scroll {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        thead {
            background: rgba(255, 255, 255, 0.025);
        }

        th {
            padding: 17px 22px;
            border-bottom: 1px solid var(--border);
            color: #858faa;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        td {
            padding: 19px 22px;
            border-bottom: 1px solid rgba(148, 163, 184, 0.09);
            color: #d5dbee;
            font-size: 13px;
            vertical-align: middle;
        }

        tbody tr {
            transition: background 0.2s;
        }

        tbody tr:hover {
            background: rgba(139, 92, 246, 0.055);
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .serial {
            color: #7f89a4;
        }

        .short-id {
            display: inline-flex;
            align-items: center;
            padding: 7px 10px;
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 7px;
            background: rgba(139, 92, 246, 0.09);
            color: #c4b5fd;
            font-family: monospace;
            font-size: 13px;
            font-weight: 700;
        }

        .redirect-url {
            display: block;
            max-width: 390px;
            overflow: hidden;
            color: #a5b4fc;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .click-badge {
            display: inline-flex;
            min-width: 34px;
            justify-content: center;
            padding: 7px 10px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.035);
            color: #e2e8f0;
            font-weight: 600;
        }

        .empty-state {
            padding: 48px 20px;
            text-align: center;
            color: var(--muted);
            font-size: 14px;
        }

        .empty-icon {
            margin-bottom: 13px;
            font-size: 32px;
        }

        .empty-state strong {
            display: block;
            margin-bottom: 8px;
            color: #e2e8f0;
            font-size: 16px;
        }

        .footer {
            max-width: 1160px;
            margin: 60px auto 0;
            padding-top: 23px;
            display: flex;
            justify-content: space-between;
            gap: 15px;
            border-top: 1px solid var(--border);
            color: #68738d;
            font-size: 12px;
        }

        .footer strong {
            color: #a78bfa;
        }

        @media (max-width: 650px) {
            body {
                padding: 0 16px 35px;
            }

            .navbar {
                height: 72px;
            }

            .brand {
                font-size: 21px;
            }

            .brand-icon {
                width: 37px;
                height: 37px;
            }

            .nav-tag {
                padding: 7px 9px;
                font-size: 10px;
            }

            .hero {
                margin: 55px auto 35px;
            }

            h1 {
                letter-spacing: -2px;
            }

            .hero-description {
                font-size: 14px;
            }

            .shortener-card {
                padding: 23px 18px;
                border-radius: 17px;
            }

            .input-group {
                flex-direction: column;
            }

            input[name="url"],
            .submit-btn {
                width: 100%;
                height: 52px;
            }

            .result-card {
                padding: 19px 16px;
            }

            .result-link {
                align-items: flex-start;
                flex-direction: column;
            }

            .copy-btn {
                width: 100%;
            }

            .section-heading h2 {
                font-size: 19px;
            }

            th,
            td {
                padding: 15px 14px;
            }

            .footer {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar">
        <a href="/" class="brand">
            <div class="brand-icon">↗</div>
            URL<span>Shortner</span>
        </a>

        <div class="nav-tag">✦ SIMPLE. SMART. SHORT.</div>
    </nav>

    <main>
        <section class="hero">
            <div class="eyebrow">
                <span class="eyebrow-dot"></span>
                YOUR LINKS, SIMPLIFIED
            </div>

            <h1>
                Long links.<br>
                <span class="gradient-text">Short-url magic.</span>
            </h1>

            <p class="hero-description">
                Turn long, complicated URLs into clean, shareable links.
                Create short links and keep track of every click in one place.
            </p>
        </section>

        <section class="shortener-card">
            <div class="card-heading">
                <h2>Shorten your URL</h2>
                <p>Paste your destination link below to create a shorter link.</p>
            </div>

            <form method="post" action="/url">
                <label for="url">Destination URL</label>

                <div class="input-group">
                    <input
                        type="text"
                        id="url"
                        name="url"
                        placeholder="https://your-long-url.com/page"
                        autocomplete="url"
                        required
                    >

                    <button type="submit" class="submit-btn">
                        <span>✂</span>
                        Shorten URL
                        <span>→</span>
                    </button>
                </div>

                <div class="helper-text">
                    <span>🔒</span>
                    Your original destination is preserved.
                </div>
            </form>
        </section>

        <% if (locals.id) { %>
            <section class="result-card">
                <div class="result-title">
                    <span>✓</span>
                    Your short link is ready!
                </div>

                <div class="result-link">
                    <a
                        href="/<%= encodeURIComponent(id) %>"
                        id="generatedUrl"
                        target="_blank"
                        rel="noopener noreferrer"
                    ><%= `${typeof origin !== 'undefined' ? origin : 'http://localhost:8001'}/${id}` %></a>

                    <button
                        type="button"
                        class="copy-btn"
                        onclick="copyShortUrl()"
                    >▢ Copy link</button>
                </div>
            </section>
        <% } %>

        <section class="dashboard">
            <div class="section-heading">
                <div>
                    <h2>Your link dashboard</h2>
                    <p>Manage your shortened URLs and monitor their clicks.</p>
                </div>

                <div class="link-count">
                    ✦ <%= locals.urls ? urls.length : 0 %> LINKS
                </div>
            </div>

            <div class="table-card">
                <% if (locals.urls && urls.length > 0) { %>
                    <div class="table-scroll">
                        <table>
                            <thead>
                                <tr>
                                    <th>S. No</th>
                                    <th>Short ID</th>
                                    <th>Destination URL</th>
                                    <th>Total Clicks</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% urls.forEach((url, index) => { %>
                                    <tr>
                                        <td class="serial">
                                            <%= String(index + 1).padStart(2, '0') %>
                                        </td>

                                        <td>
                                            <a
                                                class="short-id"
                                                href="/<%= encodeURIComponent(url.shortId) %>"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            ><%= url.shortId %></a>
                                        </td>

                                        <td>
                                            <a
                                                class="redirect-url"
                                                href="<%= url.redirectURL %>"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                title="<%= url.redirectURL %>"
                                            ><%= url.redirectURL %></a>
                                        </td>

                                        <td>
                                            <span class="click-badge">
                                                <%= url.visitHistory.length %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <div class="empty-icon">↗</div>
                        <strong>No links yet</strong>
                        Your shortened URLs will appear here once you create one.
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <footer class="footer">
        <span>© <%= new Date().getFullYear() %> <strong>short-url</strong>. Made for better sharing.</span>
        <span>Less URL. More impact. ✦</span>
    </footer>

    <script>
        async function copyShortUrl() {
            const link = document.getElementById("generatedUrl");
            const button = document.querySelector(".copy-btn");

            if (!link || !button) return;

            try {
                await navigator.clipboard.writeText(link.href);
                button.textContent = "✓ Copied!";
            } catch (error) {
                const textArea = document.createElement("textarea");
                textArea.value = link.href;
                textArea.style.position = "fixed";
                textArea.style.opacity = "0";
                document.body.appendChild(textArea);
                textArea.select();

                const copied = document.execCommand("copy");
                textArea.remove();

                button.textContent = copied ? "✓ Copied!" : "Copy failed";
            }

            setTimeout(() => {
                button.textContent = "▢ Copy link";
            }, 2000);
        }
    </script>

</body>
</html>