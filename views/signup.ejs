<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Account | short-url</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #080b16;
            --panel: #111629;
            --primary: #8b5cf6;
            --primary-hover: #7c3aed;
            --text: #f8fafc;
            --muted: #929bb5;
            --border: rgba(148, 163, 184, 0.16);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 20px;

            font-family: "Inter", sans-serif;
            color: var(--text);

            background:
                radial-gradient(
                    ellipse at 12% 8%,
                    rgba(124, 58, 237, 0.20),
                    transparent 40%
                ),
                radial-gradient(
                    ellipse at 90% 90%,
                    rgba(37, 99, 235, 0.14),
                    transparent 38%
                ),
                var(--bg);
        }

        .signup-container {
            width: 100%;
            max-width: 440px;
        }

        /* Brand */
        .brand {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            margin-bottom: 30px;

            color: var(--text);
            font-size: 27px;
            font-weight: 800;
            letter-spacing: -1px;
            text-decoration: none;
        }

        .brand-icon {
            width: 46px;
            height: 46px;
            display: grid;
            place-items: center;
            border-radius: 14px;

            background: linear-gradient(135deg, #a78bfa, #6d28d9);
            box-shadow: 0 8px 30px rgba(139, 92, 246, 0.30);

            color: white;
            font-size: 25px;
        }

        .brand-name span {
            color: #a78bfa;
        }

        /* Signup card */
        .signup-card {
            padding: 36px 38px;
            border: 1px solid rgba(167, 139, 250, 0.20);
            border-radius: 22px;

            background: linear-gradient(
                145deg,
                rgba(23, 29, 52, 0.97),
                rgba(14, 19, 36, 0.97)
            );

            box-shadow:
                0 25px 80px rgba(0, 0, 0, 0.32),
                inset 0 1px 0 rgba(255, 255, 255, 0.025);
        }

        .welcome-tag {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 12px;
            margin-bottom: 20px;

            border: 1px solid rgba(167, 139, 250, 0.22);
            border-radius: 30px;

            background: rgba(139, 92, 246, 0.08);
            color: #c4b5fd;

            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        .welcome-tag span {
            color: #a78bfa;
        }

        h1 {
            margin-bottom: 12px;
            font-size: 30px;
            font-weight: 800;
            letter-spacing: -1.2px;
        }

        .subtitle {
            margin-bottom: 28px;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.8;
        }

        /* Form */
        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 9px;
            color: #dbe2f3;
            font-size: 13px;
            font-weight: 600;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            top: 50%;
            left: 15px;
            transform: translateY(-50%);

            color: #7f89a4;
            font-size: 16px;
            pointer-events: none;
        }

        input {
            width: 100%;
            height: 51px;
            padding: 0 15px 0 44px;

            border: 1px solid #303852;
            border-radius: 11px;
            outline: none;

            background: #0b1020;
            color: var(--text);

            font-family: inherit;
            font-size: 13px;

            transition: border-color 0.2s, box-shadow 0.2s;
        }

        input::placeholder {
            color: #67718c;
        }

        input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
        }

        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus {
            -webkit-text-fill-color: var(--text);
            -webkit-box-shadow: 0 0 0 1000px #0b1020 inset;
            transition: background-color 5000s ease-in-out 0s;
        }

        /* Button */
        .signup-btn {
            width: 100%;
            min-height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;

            margin-top: 7px;
            border: none;
            border-radius: 11px;

            background: linear-gradient(135deg, #8b5cf6, #6d28d9);
            color: white;

            font-family: inherit;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;

            box-shadow: 0 8px 24px rgba(124, 58, 237, 0.22);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .signup-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(124, 58, 237, 0.35);
        }

        .signup-btn:active {
            transform: translateY(0);
        }

        .signup-btn:focus-visible,
        .login a:focus-visible {
            outline: 2px solid #c4b5fd;
            outline-offset: 4px;
        }

        /* Login link */
        .login {
            margin-top: 25px;
            padding-top: 22px;
            border-top: 1px solid var(--border);

            text-align: center;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.8;
        }

        .login a {
            color: #c4b5fd;
            font-weight: 700;
            text-decoration: none;
        }

        .login a:hover {
            color: white;
            text-decoration: underline;
        }

        .footer {
            margin-top: 25px;
            text-align: center;
            color: #68738d;
            font-size: 11px;
        }

        .footer span {
            color: #a78bfa;
        }

        @media (max-width: 480px) {
            body {
                padding: 24px 16px;
            }

            .brand {
                margin-bottom: 24px;
                font-size: 24px;
            }

            .brand-icon {
                width: 42px;
                height: 42px;
            }

            .signup-card {
                padding: 28px 22px;
                border-radius: 18px;
            }

            h1 {
                font-size: 27px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                transition: none !important;
            }
        }
    </style>
</head>

<body>

    <main class="signup-container">

        <a href="/" class="brand" aria-label="short-url home">
            <div class="brand-icon" aria-hidden="true">↗</div>

            <div class="brand-name">
                short<span>-url</span>
            </div>
        </a>

        <section class="signup-card">

            <div class="welcome-tag">
                <span>✦</span>
                Start for free
            </div>

            <h1>Create your account</h1>

            <p class="subtitle">
                Join short-url and turn long links into
                simple, shareable URLs. Your smarter link
                management starts here.
            </p>

            <form action="/user" method="post">

                <div class="form-group">
                    <label for="name">Full name</label>

                    <div class="input-wrapper">
                        <span class="input-icon" aria-hidden="true">♙</span>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter your full name"
                            autocomplete="name"
                            required
                        >
                    </div>
                </div>

                <div class="form-group">
                    <label for="email">Email address</label>

                    <div class="input-wrapper">
                        <span class="input-icon" aria-hidden="true">✉</span>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="you@example.com"
                            autocomplete="email"
                            required
                        >
                    </div>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>

                    <div class="input-wrapper">
                        <span class="input-icon" aria-hidden="true">♙</span>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Create a password"
                            autocomplete="new-password"
                            required
                        >
                    </div>
                </div>

                <button type="submit" class="signup-btn">
                    Create account
                    <span aria-hidden="true">→</span>
                </button>

            </form>

            <div class="login">
                Already have an account?
                <a href="/login">Sign in →</a>
            </div>

        </section>

        <footer class="footer">
            © <%= new Date().getFullYear() %>
            <span>short-url</span>. Made for better sharing.
        </footer>

    </main>

</body>
</html>